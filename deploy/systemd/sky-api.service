[Unit]
Description=SPHEREx Sky API and warm runner
After=network-online.target
Wants=network-online.target

[Service]
User=sky
WorkingDirectory=/opt/sky
EnvironmentFile=/etc/sky/env
Environment=SKY_STORE=/var/lib/sky
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=SKY_WEB_DIST=/opt/sky/web/dist
ExecStart=/home/sky/.local/bin/uv run --no-dev uvicorn service.app:app --host 127.0.0.1 --port 8780 --timeout-graceful-shutdown 25
Restart=always
RestartSec=3
TimeoutStopSec=40
KillMode=mixed
LimitNOFILE=65536
# memory: the scheduler admits jobs within its budget; this is the outer fence
# 70 % of the machine (33 GB on the 48 GB E5, 8.4 GB on a 12 GB A1); service/machine.py keeps the jobs' budget within 55 % of it
MemoryMax=70%

[Install]
WantedBy=multi-user.target
